{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OSLC": {
    "ServiceTitle": "OSLC Requirements Management server for StrictDoc"
  },
  "StrictDoc": {
    "StaticFilesPath": "/data/html"
  },
  "ConfigurationManagement": {
    "DataRootPath": "/data",
    "DefaultBranch": "main",
    "DefaultTag": "HEAD"
  }
}
