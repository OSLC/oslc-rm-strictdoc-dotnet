@model StrictDocOslcRm.Models.ConfigurationSelectionViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StrictDoc Configuration Selection</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body {
            display: flex;
            width: 100%;
            max-width: 100vw;
            min-height: 100vh;
            flex-direction: column;
            overflow-x: hidden;
            padding: 1rem;
            color: #16221f;
            font-family: system-ui, sans-serif;
        }
        main { width: 100%; min-width: 0; flex: 1; }
        form { min-width: 0; }
        label { display: block; margin-bottom: .4rem; }
        input { width: 100%; max-width: 100%; padding: .65rem; font: inherit; }
        ul { margin: 1rem 0 0; padding: 0; list-style: none; }
        li { border-top: 1px solid #ccd8d2; padding: .7rem 0; }
        a { color: #006b5f; text-decoration: none; font-weight: 650; }
        small { display: block; color: #4c5d57; margin-top: .15rem; }
        .empty-state {
            margin: 1rem 0 0;
            padding: 1rem;
            border: 1px solid #ccd8d2;
            color: #4c5d57;
            text-align: center;
        }
        footer {
            display: flex;
            width: 100%;
            min-width: 0;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: .5rem 1.5rem;
            margin-top: 1rem;
            padding-top: .75rem;
            border-top: 1px solid #ccd8d2;
            color: #63736d;
            font-size: .8rem;
        }
        footer span { min-width: 0; }
        footer span:last-child { margin-left: auto; text-align: right; }
        footer strong { color: #344740; font-weight: 650; }
    </style>
</head>
<body>
    <main>
        <form method="get" action="@Model.SelectorUri">
            <label for="terms">Search configurations</label>
            <input id="terms" type="search" name="terms" value="@Model.Terms" placeholder="Type to search by id/title/description" autofocus />
        </form>
        @if (Model.Results.Count == 0)
        {
            <p class="empty-state" role="status">No configurations found</p>
        }
        else
        {
            <ul>
            @foreach (var configuration in Model.Results)
            {
                <li>
                    <a href="@configuration.GetAbout()" onclick="return selectConfiguration(this, event)">@configuration.Title</a>
                    <small>@configuration.Identifier</small>
                </li>
            }
            </ul>
        }
    </main>
    <footer>
        <span>OSLC Selection Dialog for <strong>Configurations</strong></span>
        <span>StrictDoc OSLC server</span>
    </footer>
    <script>
        function selectConfiguration(target, event) {
            window.parent.postMessage('oslc-response:' + JSON.stringify({
                'oslc:results': [{ 'oslc:label': target.text, 'rdf:resource': target.href }]
            }), '*');
            event.preventDefault();
            return false;
        }
    </script>
</body>
</html>
